extends Node2D
## Level 01 - "The Whispering Grove". Owns checkpoints, respawning, the boss
## arena sequence and the level exit. The scene itself is generated by
## tools/build_scenes.gd (see README).

const Fx := preload("res://scripts/fx.gd")
const BOSS_SCENE := preload("res://scenes/boss.tscn")

signal player_ready(player: Node)
signal boss_fight_started(boss: Node)
signal boss_fight_ended
signal level_completed
signal game_over
signal toast(text: String)

@export var level_pixel_size: Vector2i = Vector2i(4160, 448)
@export var arena_left: float = 3440.0
@export var arena_right: float = 4096.0
@export var boss_spawn: Vector2 = Vector2(3900, 320)

var player: CharacterBody2D
var boss: CharacterBody2D
var respawn_point: Vector2
var boss_active: bool = false
var boss_dead: bool = false

var _checkpoints: Array[Node] = []
var _handling_death: bool = false

@onready var boss_trigger: Area2D = $BossTrigger
@onready var arena_gate: StaticBody2D = $ArenaGate
@onready var exit_portal: Area2D = $Exit
@onready var start_marker: Marker2D = $PlayerStart


func _ready() -> void:
	player = $Player
	respawn_point = start_marker.global_position
	player.set_camera_limits(Rect2i(0, 0, level_pixel_size.x, level_pixel_size.y))
	player.projectile_parent = self
	player.died.connect(_on_player_died)
	player.fell_into_pit.connect(_on_player_fell)
	for cp in get_tree().get_nodes_in_group("checkpoints"):
		_checkpoints.append(cp)
		cp.activated.connect(_on_checkpoint)
	boss_trigger.triggered.connect(_on_boss_trigger)
	exit_portal.entered.connect(_on_exit_entered)
	_set_arena_closed(false, true)
	_spawn_boss()
	_count_collectibles()
	AudioManager.play_music(&"forest")
	var amb: Array[StringName] = [&"wind", &"night"]
	AudioManager.play_ambient(amb)
	player_ready.emit(player)


func _count_collectibles() -> void:
	var c := 0
	var s := 0
	for p in get_tree().get_nodes_in_group("pickups"):
		match int(p.get("kind")):
			0:
				c += 1
			1:
				s += 1
	GameManager.start_new_run(c, s)


# ------------------------------------------------------------------ checkpoints
func _on_checkpoint(cp: Node) -> void:
	respawn_point = cp.get_respawn_position()
	toast.emit("Checkpoint reached")


# ------------------------------------------------------------------ death / respawn
func _on_player_fell() -> void:
	if _handling_death:
		return
	if GameManager.lives <= 1 and player.health <= 1:
		player.health = 0
		player.health_changed.emit(0, player.max_health)
		player._die()
		return
	player.fall_penalty(respawn_point)
	if player.health <= 0:
		return
	AudioManager.play_sfx(&"respawn")


func _on_player_died() -> void:
	if _handling_death:
		return
	_handling_death = true
	GameManager.register_death()
	if GameManager.lives <= 0:
		GameManager.timer_running = false
		AudioManager.stop_music(0.5)
		AudioManager.play_sfx(&"game_over")
		game_over.emit()
		return
	await get_tree().create_timer(0.4).timeout
	_respawn()
	_handling_death = false


func _respawn() -> void:
	if boss_active and not boss_dead:
		_reset_boss_fight()
	player.respawn(respawn_point)
	toast.emit("Lives left: %d" % GameManager.lives)


func _reset_boss_fight() -> void:
	boss_active = false
	_set_arena_closed(false, false)
	if is_instance_valid(boss):
		boss.queue_free()
	_spawn_boss()
	boss_trigger.reset()
	player.set_camera_limits(Rect2i(0, 0, level_pixel_size.x, level_pixel_size.y))
	boss_fight_ended.emit()
	AudioManager.play_music(&"forest")


# ------------------------------------------------------------------ boss
func _spawn_boss() -> void:
	boss = BOSS_SCENE.instantiate()
	boss.arena_left = arena_left
	boss.arena_right = arena_right
	add_child(boss)
	boss.global_position = boss_spawn
	boss.defeated.connect(_on_boss_defeated)


func _on_boss_trigger(_body: Node) -> void:
	if boss_active or boss_dead:
		return
	boss_active = true
	_set_arena_closed(true, false)
	player.set_camera_limits(Rect2i(int(arena_left) - 8, 0, int(arena_right - arena_left) + 16, level_pixel_size.y))
	AudioManager.play_music(&"boss", 0.6)
	player.shake(2.0, 0.4)
	await get_tree().create_timer(0.8).timeout
	if boss_active and is_instance_valid(boss):
		boss.awaken()
		boss_fight_started.emit(boss)


func _set_arena_closed(closed: bool, instant: bool) -> void:
	var shape: CollisionShape2D = arena_gate.get_node("Shape")
	var vis: Node2D = arena_gate.get_node("Visual")
	shape.set_deferred("disabled", not closed)
	if instant:
		vis.modulate.a = 1.0 if closed else 0.0
		vis.visible = closed
		return
	if closed:
		vis.visible = true
		AudioManager.play_sfx(&"gate")
		create_tween().tween_property(vis, "modulate:a", 1.0, 0.5)
	else:
		var tw := create_tween()
		tw.tween_property(vis, "modulate:a", 0.0, 0.5)
		tw.tween_callback(func() -> void: vis.visible = false)


func _on_boss_defeated() -> void:
	boss_dead = true
	boss_active = false
	_set_arena_closed(false, false)
	exit_portal.set_unlocked(true)
	AudioManager.stop_music(1.5)
	AudioManager.set_music_ducked(false)
	await get_tree().create_timer(0.6).timeout
	AudioManager.play_sfx(&"victory")
	boss_fight_ended.emit()
	toast.emit("The Gloomhorn falls! Enter the portal")
	Fx.sparkle(self, exit_portal.global_position + Vector2(0, -24), Color(0.5, 0.97, 1.0))
	await get_tree().create_timer(2.2).timeout
	AudioManager.play_music(&"forest", 2.0)


# ------------------------------------------------------------------ finish
func _on_exit_entered(_body: Node) -> void:
	player.lock_controls(true)
	player.velocity = Vector2.ZERO
	GameManager.finish_level()
	level_completed.emit()
